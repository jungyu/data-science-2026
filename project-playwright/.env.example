# Playwright 專案環境設定
# 複製為 .env 並依需求修改

# 瀏覽器設定
HEADLESS=true
SLOW_MO=0
BROWSER_TYPE=chromium

# 預設視窗大小
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# 截圖 / 輸出路徑
OUTPUT_DIR=./output
SCREENSHOT_DIR=./output/screenshots

# Proxy（選填）
# PROXY_SERVER=http://proxy.example.com:8080

# 除錯模式
DEBUG=false

# Supabase（選填，ch08 整合時需要）
# 取得方式：Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# SUPABASE_SERVICE_KEY 必須是「能繞過 RLS 的後端 key」，二選一即可：
#   1. 新系統「API Keys」區塊的 secret key（推薦，未來預設）：
#         SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   2. 舊系統「Project API keys」區塊的 service_role key（legacy，仍支援）：
#         SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# 不要用 publishable / anon / legacy public key — 那些前端用，被 RLS 擋。
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多租戶識別（對應 crawler.sources.project_id）
PROJECT_ID=demo-project

# 安全須知：secret / service_role key 擁有完整 DB 存取權，
#   只用於後端 worker（ch08）；絕不放進前端 / mobile / 公開 repo。
#   前端應用請改用 publishable / anon key + RLS policy。

# OpenAlex polite pool（選填，drone_data/03 範例使用）
# 帶 mailto 進 polite pool，回應更快、優先級更高
# OPENALEX_MAILTO=you@example.com

# IEEE Xplore Metadata Search API（選填，drone_data/04 範例使用）
# 申請：https://developer.ieee.org/getting_started
# 注意：申請後 status=waiting，通常 1-2 工作天才會 activate
# IEEE_XPLORE_API_KEY=your-24-char-api-key
