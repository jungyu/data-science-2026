# Playwright 專案環境設定
# 複製為 .env 並依需求修改

# 瀏覽器設定
HEADLESS=true
SLOW_MO=0
BROWSER_TYPE=chromium

# 預設視窗大小
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# 截圖 / 輸出路徑
OUTPUT_DIR=./output
SCREENSHOT_DIR=./output/screenshots

# Proxy（選填）
# PROXY_SERVER=http://proxy.example.com:8080

# 除錯模式
DEBUG=false

# Supabase（選填，ch08 整合時需要）
# 取得方式：Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 多租戶識別（對應 crawler.sources.project_id）
PROJECT_ID=demo-project

# 注意：ch08 使用 service_role key（繞過 RLS），
# 適合後端 worker。前端應用請改用 anon key + JWT。

# OpenAlex polite pool（選填，drone_data/03 範例使用）
# 帶 mailto 進 polite pool，回應更快、優先級更高
# OPENALEX_MAILTO=you@example.com

# IEEE Xplore Metadata Search API（選填，drone_data/04 範例使用）
# 申請：https://developer.ieee.org/getting_started
# 注意：申請後 status=waiting，通常 1-2 工作天才會 activate
# IEEE_XPLORE_API_KEY=your-24-char-api-key
